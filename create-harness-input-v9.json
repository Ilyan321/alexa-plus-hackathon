{
  "harnessName": "EchoForgeHarnessV9",
  "executionRoleArn": "arn:aws:iam::152307755678:role/EchoForgeHarnessRole",
  "model": {
    "bedrockModelConfig": {
      "modelId": "us.amazon.nova-pro-v1:0",
      "apiFormat": "converse_stream"
    }
  },
  "systemPrompt": [
    {
