      "config": {
        "agentCoreGateway": {
          "gatewayArn": "arn:aws:bedrock-agentcore:us-east-1:152307755678:gateway/echoforgegateway-gbu5h7w7f2"
        }
      }
    }
  ],
  "maxIterations": 10,
  "maxTokens": 4096,
  "timeoutSeconds": 300
}
